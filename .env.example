# ---------------------------------------------------------------------------
# HVOps V1 - copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=hvops
POSTGRES_PASSWORD=hvops
POSTGRES_DB=hvops
DATABASE_URL=postgresql+asyncpg://hvops:hvops@postgres:5432/hvops

# Mongo
MONGO_URL=mongodb://mongo:27017
MONGO_DB=hvops

# Auth
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
SEED_ADMIN_EMAIL=admin@hvops.local
SEED_ADMIN_PASSWORD=admin123

# Fernet key used to encrypt hypervisor source credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=JDMvXWJ2m8V0cM0LhV8lFBWQxYc2Lh7Yq0K9Yy1n4Vo=

# Internal service auth
INTERNAL_SERVICE_TOKEN=change-me-too

# Collector
API_INTERNAL_URL=http://api:8000/internal
COLLECTOR_URL=http://collector:5000
POLL_INVENTORY_SECONDS=300
POLL_METRICS_SECONDS=60
VSPHERE_HOST=vcsim
VSPHERE_PORT=8989
VSPHERE_USER=user
VSPHERE_PASSWORD=pass
VSPHERE_INSECURE=true
NUTANIX_URL=http://nutanix-mock:9440
NUTANIX_USER=admin
NUTANIX_PASSWORD=admin

# LLM
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5-7b-instruct
# Sharded models: name the FIRST shard; llama.cpp loads the rest itself.
LLM_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
LLM_CTX=8192
LLM_TEMPERATURE=0.2

# ML
ML_ARTIFACT_DIR=/ml_artifacts

# Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000

# Host port mappings. Container-to-container traffic never uses these; change
# them when something else on your machine already owns the port.
# (macOS note: AirPlay Receiver listens on 5000, so the collector defaults to 5001.)
POSTGRES_PORT=5432
MONGO_PORT=27017
API_PORT=8000
COLLECTOR_PORT=5001
FRONTEND_PORT=5173
VCSIM_PORT=8989
NUTANIX_PORT=9440
LLM_PORT=8080
